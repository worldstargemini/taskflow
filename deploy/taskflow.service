# /etc/systemd/system/taskflow.service
[Unit]
Description=TaskFlow FastAPI app
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/taskflow
# GIT_SHA is written here by deploy.sh; the leading "-" means "ok if missing"
EnvironmentFile=-/opt/taskflow/.env
Environment=TASKFLOW_DB=/opt/taskflow/taskflow.db
ExecStart=/opt/taskflow/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
